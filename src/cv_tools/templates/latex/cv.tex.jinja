{#- Spaces and line breaks inside TeX arguments reproduce cv-tools 1.x exactly. -#}
{%- import 'layouts/entries.jinja' as entries -%}
{%- import 'layouts/entries-inline.jinja' as entries_inline -%}
{%- import 'layouts/list.jinja' as list -%}
{%- import 'layouts/pairs.jinja' as pairs -%}
{%- import 'layouts/dated.jinja' as dated -%}
{%- import 'layouts/text.jinja' as text -%}
{%- import 'layouts/publications.jinja' as publications -%}
% Generated by cv-tools {{ version }}. Compile with pdflatex next to resume.cls and orcid.pdf.

\documentclass{resume}

% ====================== Heading Section ====================== %
\name{ {{name}} }
{%- if addresses %}

% ====================== Sub-heading Section ====================== %
{%- for address in addresses %}
\address{ {{- address -}} }
{%- endfor %}
{%- endif %}

\begin{document}

{% for section in sections -%}
  {%- if section.layout == 'entries' -%}
    {{- entries.render(section) -}}
  {%- elif section.layout == 'entries-inline' -%}
    {{- entries_inline.render(section) -}}
  {%- elif section.layout == 'list' -%}
    {{- list.render(section) -}}
  {%- elif section.layout == 'pairs' -%}
    {{- pairs.render(section) -}}
  {%- elif section.layout == 'dated' -%}
    {{- dated.render(section) -}}
  {%- elif section.layout == 'text' -%}
    {{- text.render(section) -}}
  {%- elif section.layout == 'publications' -%}
    {{- publications.render(section) -}}
  {%- elif section.layout == 'newpage' -%}
\newpage
  {%- endif -%}
{%- endfor %}

\end{document}
