{
  "name": "cv-tools-web-engine",
  "private": true,
  "description": "Builds and tests the pdfTeX WebAssembly engine bundle of the cv-tools web app",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "fetch": "node fetch.mjs",
    "build": "node build-bundle.mjs",
    "mirror-sources": "node mirror-sources.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run typecheck && node --disable-warning=ExperimentalWarning --test --test-concurrency=1 --test-reporter=spec \"test/*.test.mjs\""
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
