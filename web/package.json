{
  "name": "cv-tools-web",
  "private": true,
  "version": "0.0.0",
  "description": "Browser editor for cv-tools CV files, running cv-tools in Pyodide and pdfLaTeX in WebAssembly",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "assets": "node scripts/prepare-assets.mjs",
    "dev": "npm run assets && vite",
    "build": "npm run assets && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "screenshots": "playwright test --project=chromium test/e2e/screenshots.spec.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "computer-modern": "0.1.3",
    "pdfjs-dist": "6.4.299",
    "pyodide": "314.0.7",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/jsdom": "28.0.3",
    "@types/node": "24.19.2",
    "axe-core": "4.13.0",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
